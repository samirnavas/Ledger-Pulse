<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_expense"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- Left Column: Metrics & Spend Progress -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <!-- Header: Profile Name and Wallet Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_company_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Profile Name"
                android:textColor="@color/widget_expense_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_wallet_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Wallet"
                android:src="@drawable/ic_widget_wallet" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Metric Header: Today -->
        <TextView
            android:id="@+id/widget_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Today"
            android:textColor="@color/widget_expense_subtext"
            android:textSize="14sp" />

        <!-- Large Spend Amount: ₹2,000 -->
        <TextView
            android:id="@+id/widget_today_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="38sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="₹2,000"
            android:textColor="@color/widget_expense_text"
            android:textSize="36sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Horizontal Spending Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_expense_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="58"
            android:progressDrawable="@drawable/widget_progress_bar_expense" />

        <!-- Progress Metrics: Spend - 2000/3700 & 58% -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_expense_spend_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Spend - 2000/3700"
                android:textColor="@color/widget_expense_subtext"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expense_spend_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="58%"
                android:textColor="@color/widget_expense_subtext"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Column: Plus Button, Donut Breakdown Chart & Category Legend -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top Right Plus Quick Add Action -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_expense_add_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:clickable="true"
                android:contentDescription="Add Expense"
                android:focusable="true"
                android:src="@drawable/ic_widget_add" />
        </FrameLayout>

        <!-- Donut Category Breakdown Chart -->
        <ImageView
            android:id="@+id/widget_expense_donut_chart"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:contentDescription="Category breakdown" />

        <!-- Category Legend Items -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_expense_category_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="• Food &amp; Dining"
                android:textColor="@color/widget_expense_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expense_category_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="• Groceries"
                android:textColor="@color/widget_expense_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expense_category_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="• Travel"
                android:textColor="@color/widget_expense_text"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
