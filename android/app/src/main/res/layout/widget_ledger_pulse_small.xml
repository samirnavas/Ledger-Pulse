<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Active Company Name -->
    <TextView
        android:id="@+id/widget_company_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Ledger Enterprise"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Inflow Metric Row (Cash In / Receivable) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_inflow_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="↑"
            android:textColor="@color/widget_inflow_indicator"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_inflow_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif"
            android:text="₹"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_cash_in_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="2,000"
            android:textColor="@color/widget_on_surface"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Structural Tonal Divider -->
    <ImageView
        android:id="@+id/widget_divider_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="Divider"
        android:src="@drawable/widget_divider" />

    <!-- Outflow Metric Row (Cash Out / Payable) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_outflow_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="↓"
            android:textColor="@color/widget_outflow_indicator"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_outflow_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif"
            android:text="₹"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_cash_out_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="1,000"
            android:textColor="@color/widget_on_surface"
            android:textSize="24sp" />
    </LinearLayout>

</LinearLayout>
